{
  "name": "eldercare-assessment-flow",
  "version": "1.0.0",
  "description": "养老机构评估-复核-告知-费用生效 服务端流程演示（虚构量表，非医疗用途）",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/src/db/schema.sql",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "pg:start": "bash scripts/pg-ctl.sh start",
    "pg:stop": "bash scripts/pg-ctl.sh stop",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5"
  }
}
